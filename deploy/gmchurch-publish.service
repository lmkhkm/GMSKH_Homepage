[Unit]
Description=광명교회 홈페이지 git 배포
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# bash 를 명시적으로 호출합니다.
# Windows 에서 커밋하면 실행 권한(+x)이 저장소에 기록되지 않는데,
# publish.sh 안의 git reset --hard 가 파일 권한을 저장소 기준으로 되돌리기
# 때문에 실행 권한에 의존하면 첫 배포 이후 타이머가 멈출 수 있습니다.
ExecStart=/bin/bash /srv/gmchurch/deploy/publish.sh
# git/rsync 가 멈춰도 타이머가 막히지 않도록 상한을 둡니다
TimeoutStartSec=300
